# ─────────────────────────────────────────────────────────────────────────────
# AI Enhancement App — configuration
#
# The app can run with an empty .env using deterministic offline providers, but
# setting OPENAI_API_KEY automatically enables analysis, speech-to-text and
# visual text reading unless you explicitly choose different providers below.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public origin of the API, used in notification links and CORS.
PUBLIC_URL=http://localhost:4000
# Comma-separated list of extra allowed browser origins (the PWA dev server).
CORS_ORIGINS=http://localhost:5173

# Signing secret for access tokens. MUST be set to a long random value in
# production — the server refuses to boot with the default when NODE_ENV=production.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Set to false to lock down a personal deployment after you have made your account.
ALLOW_SIGNUP=true

# ── Storage ──────────────────────────────────────────────────────────────────
# Metadata DB (SQLite). Point at a persistent volume in production.
DATABASE_PATH=./data/aiapp.sqlite
# Object storage root for media, transcripts and generated artifacts.
STORAGE_PATH=./data/storage
# Where per-link artifact folders are assembled before the desktop bridge syncs them.
ARTIFACT_ROOT=./data/artifacts
# Days to retain raw media (audio/frames) before purge. Derived text is kept.
MEDIA_RETENTION_DAYS=14

# ── Model providers ──────────────────────────────────────────────────────────
# One key powers three things: insight extraction, reading text off video
# frames (OCR), and agentic implementation. Leave every key blank to run the
# offline rule-based analyzer instead — the app still works, it just matches
# keywords rather than understanding the post.
#
# auto | openai | claude | offline   ("auto" = whichever key is set below;
# Anthropic wins if you happen to set both.)
LLM_PROVIDER=openai

# ── OpenAI ───────────────────────────────────────────────────────────────────
# This single key drives analysis, OCR *and* speech-to-text (Whisper).
OPENAI_API_KEY=
# Must be a model your account can actually reach, and must support vision +
# tool calling. A wrong ID here returns 404 and the app falls back to the
# offline analyzer — the server log will name this variable if that happens.
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
# Override for Azure OpenAI or any OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
# Budget accounting only; your real bill is authoritative.
OPENAI_INPUT_USD_PER_MTOK=2.5
OPENAI_OUTPUT_USD_PER_MTOK=10

# ── Anthropic (alternative to OpenAI — leave blank if using OpenAI) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# ── Speech-to-text ───────────────────────────────────────────────────────────
# stub | openai | whisper-local | assemblyai | deepgram
# "stub" transcribes nothing at all. "openai" reuses OPENAI_API_KEY above.
ASR_PROVIDER=openai
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Local whisper.cpp / faster-whisper CLI, when ASR_PROVIDER=whisper-local
WHISPER_BIN=whisper
WHISPER_MODEL=large-v3

# ── Vision / OCR — reads text baked onto video frames and carousel images ────
# stub | openai | claude | tesseract
# "openai" and "claude" follow LLM_PROVIDER above. "tesseract" is a free local
# fallback needing no key (brew install tesseract), but is much weaker on the
# stylized overlay text short-form video is full of.
VISION_PROVIDER=openai
TESSERACT_BIN=tesseract

# Media fetch. yt-dlp is used when present on PATH; otherwise the HTTP fetcher
# and (optionally) the browser agent are used.
YTDLP_BIN=yt-dlp
# Instagram returns an empty media response to signed-out clients, so Reels cannot
# be fetched without a session. Set to chrome|safari|firefox to use your own
# login, or point YTDLP_COOKIES_FILE at a cookies.txt. Off by default.
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
FFMPEG_BIN=ffmpeg
# Enable the Playwright-based agentic browser for JS-rendered pages and
# UI-only implementation steps. Requires `npx playwright install chromium`.
ENABLE_BROWSER_AGENT=false

# ── Cost controls ────────────────────────────────────────────────────────────
# Hard ceilings enforced by the orchestrator before each paid stage.
MAX_USD_PER_LINK=0.75
MAX_USD_PER_USER_PER_DAY=10
MAX_ASR_SECONDS_PER_LINK=900

# ── Autonomy ─────────────────────────────────────────────────────────────────
# Global kill switch. When false the engine always dry-runs.
ENABLE_AUTONOMOUS_IMPLEMENTATION=true
# Default trust dial for new users: cautious | balanced | just_do_it
DEFAULT_TRUST_POSTURE=balanced
# Concurrent processing jobs per worker process.
WORKER_CONCURRENCY=2

# ── Notifications ────────────────────────────────────────────────────────────
# Supported: log | email | webpush  (comma-separated for multiple)
NOTIFY_CHANNELS=log
SMTP_URL=
NOTIFY_FROM=ai-enhancement-app@localhost
# Generate with: npm run vapid --workspace @aiapp/server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Quiet hours (local 24h clock). Notifications inside the window are batched.
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# ── Desktop bridge ───────────────────────────────────────────────────────────
# Used by packages/desktop-bridge to pull finished folders onto your machine.
BRIDGE_API_URL=http://localhost:4000
BRIDGE_TOKEN=
BRIDGE_DEST=~/Desktop/AI Enhancement App
BRIDGE_POLL_SECONDS=60
